# copy to .env and fill in, don't commit .env
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Supabase Storage, for photo upload (Gabriel). Supabase dashboard -> Project Settings -> API Keys.
# Without these the server still runs, only photo upload is off.
SUPABASE_URL=https://rrpcxtvqhwqtvwtwyamu.supabase.co
SUPABASE_SECRET_KEY=

# Gemini API key for the AI photo check (Gabriel). aistudio.google.com -> Get API key.
# Without it the check runs in DEMO mode (always passes), everything else works.
GEMINI_API_KEY=
# optional: which Gemini model to try first (default gemini-3.5-flash-lite, falls back to others on the daily limit)
GEMINI_MODEL=

# NETS QR sandbox: copy the API key and project ID from your NETS QR coursework .env
# (REACT_APP_SANDBOX_API_KEY / REACT_APP_SANDBOX_PROJECT_ID) or developers.openapipass.org
NETS_API_KEY=
NETS_PROJECT_ID=
NETS_TXN_ID=sandbox_nets|m|8ff8e5b6-d43e-4786-8ac5-7accf8c5bd9b
